# ─────────────────────────────────────────────
# Habit-Tracker-Daemon — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=habit_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/habit_tracker

# FastAPI Python Service
PYTHON_SERVICE_URL=http://localhost:8000
PYTHON_SERVICE_TIMEOUT_MS=5000

# Security
JWT_SECRET=change_me_in_production_use_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
