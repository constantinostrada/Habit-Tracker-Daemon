{
  "name": "habit-tracker-daemon",
  "version": "1.0.0",
  "description": "A production-ready Habit Tracker backend daemon built with TypeScript, Node.js, FastAPI bridge, and PostgreSQL following Clean Architecture principles.",
  "main": "dist/interfaces/http/server.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "start": "node dist/interfaces/http/server.js",
    "dev": "next dev",
    "lint": "eslint 'src/**/*.ts' --ext .ts",
    "lint:fix": "eslint 'src/**/*.ts' --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate": "node dist/infrastructure/database/migrate.js",
    "migrate:dev": "ts-node src/infrastructure/database/migrate.ts",
    "typecheck": "tsc --noEmit",
    "backend:dev": "ts-node-dev --respawn --transpile-only src/interfaces/http/server.ts"
  },
  "keywords": [
    "habit-tracker",
    "clean-architecture",
    "typescript",
    "fastapi",
    "postgresql"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "http-status-codes": "^2.3.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "@types/jest": "^29.5.10",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
